<?xml version="1.0" encoding="UTF-8"?>
<component-set>
  <components>
    <!-- Explicitly bind PluginDependenciesResolver implementations -->
    <component>
      <role>org.apache.maven.plugin.internal.PluginDependenciesResolver</role>
      <implementation>org.apache.maven.plugin.internal.DefaultPluginDependenciesResolver</implementation>
      <instantiation-strategy>singleton</instantiation-strategy>
    </component>

    <!-- Explicitly bind RepositorySystem for bridge compatibility -->
    <component>
      <role>org.apache.maven.repository.RepositorySystem</role>
      <implementation>org.apache.maven.bridge.MavenRepositorySystem</implementation>
      <instantiation-strategy>singleton</instantiation-strategy>
    </component>

    <!-- Explicitly bind RepositorySystemSessionFactory -->
    <component>
      <role>org.apache.maven.repository.internal.DefaultRepositorySystemSessionFactory</role>
      <implementation>org.apache.maven.internal.aether.DefaultRepositorySystemSessionFactory</implementation>
      <instantiation-strategy>singleton</instantiation-strategy>
    </component>
  </components>
</component-set>
